
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://devpulse-backend-betn.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://devpulse-backend-betn.onrender.com/openapi.json"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://devpulse-backend-betn.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
